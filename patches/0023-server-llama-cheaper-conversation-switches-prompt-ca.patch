 class llama_io_write_host : public llama_io_write_i {
 public:
     llama_io_write_host(
-            uint8_t * p, size_t len) : ptr(p), buf_size(len) {}
+            uint8_t * p, size_t len, const uint8_t * ref = nullptr, size_t ref_size = 0) : ptr(p), buf_size(len), ref(ref), ref_size(ref_size) {}
 
