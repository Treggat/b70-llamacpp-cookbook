 ggml/src/ggml-sycl/fwht.hpp      |  3 ++
 ggml/src/ggml-sycl/ggml-sycl.cpp | 65 ++++++++++++++++++++++++++++----
 tests/test-draftcost-host.cpp    | 29 ++++++++++----
 tests/test-hostv-reuse.cpp       | 22 +++++++++--
