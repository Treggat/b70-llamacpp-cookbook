-                     const std::pair<int, int> d_offset, const int8_t * q8_1_quant_ptr, const sycl::half2 * q8_1_ds,
-                     const int iqs) {
+    struct weights {
+        int    vl;
+        int    vh;
+        int8_t sc0;
+        int8_t sc1;
+        float  d;
+    };
