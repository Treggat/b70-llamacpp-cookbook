diff --git a/ggml/src/ggml-sycl/element_wise.cpp b/ggml/src/ggml-sycl/element_wise.cpp
index 58feeb2321..2c21fcea46 100644
--- a/ggml/src/ggml-sycl/element_wise.cpp
