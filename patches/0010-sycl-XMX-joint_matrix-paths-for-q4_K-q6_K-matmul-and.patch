+static int ggml_sycl_op_prof_mode() {
+    static int every = -1;
+    if (every < 0) {
+        const char * e = getenv("GGML_SYCL_OP_PROFILE");
+        every = e ? std::max(0, atoi(e)) : 0;
+        if (every > 0) {
+            std::atexit(ggml_sycl_op_prof_print);
+        }
+    }
+    return every;
+}
