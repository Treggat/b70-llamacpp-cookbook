+            ggml_backend_dev_description(dev), steps, n_ctx, n_prompt, n_vocab, (int) bsamp, n_draft, kv.c_str(), n_embd);
+
+    auto gguf = make_qwen35(4, n_vocab, n_embd);
+    llama_model_params mp = llama_model_default_params();
